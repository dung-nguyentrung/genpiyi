<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Tắt implicit usings để tránh xung đột tên giữa WPF và WinForms (Application, MessageBox...) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>genpiyi</RootNamespace>
    <AssemblyName>GenPiYi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GenPiYi.ico</ApplicationIcon>
    <Product>GenPiYi</Product>
    <Version>0.0.3</Version>
    <Authors>GenPiYi contributors</Authors>
    <Description>Pinyin popup for Chinese chat messages on Windows</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thư viện chuyển Hán tự -> pinyin (offline, có xử lý từ đa âm theo cụm từ) -->
    <PackageReference Include="ToolGood.Words.Pinyin" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Từ điển offline (CVDICT / CC-CEDICT / Unihan) – tạo bằng: python tools/build_dict.py -->
    <EmbeddedResource Include="..\data\genpiyi-dict.tsv.deflate" LogicalName="genpiyi-dict.tsv.deflate"
                      Condition="Exists('..\data\genpiyi-dict.tsv.deflate')" Link="Data\genpiyi-dict.tsv.deflate" />
  </ItemGroup>

</Project>
